# --- Local configuration and credentials -------------------------------------------------------
# Real configuration never enters Git. Only the documented template is tracked.
.env
.env.*
!.env.example
*.env
*.bak
secrets/
*.secret
*.token
credentials*.json
.netrc
.npmrc
.pypirc

# Private keys and certificates (deploy/certs is regenerated by scripts/gen_test_ca.sh)
deploy/certs/
*.key
*.pem
*.crt
*.p12
*.pfx
*.jks

# --- Python ----------------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- Node / console --------------------------------------------------------------------------
# src/aegis/console/ is the built console bundle served by the app and is intentionally tracked.
node_modules/
*.tsbuildinfo
.vite/
.vite-temp/
.eslintcache
coverage/
console/test-results/
console/playwright-report/
console/blob-report/
playwright/.cache/

# --- Local data, runtime logs and temporary files --------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.log
logs/
tmp/
*.tmp
*.swp
*~

# --- Local models (Ollama storage and weights) -----------------------------------------------
.ollama/
ollama/
models/
*.gguf
*.safetensors
*.ggml
*.onnx
*.pt
*.pth
*.ckpt

# --- Generated evidence and browser artifacts (project policy: kept local) --------------------
artifacts/
screenshots/
*.har
*.trace.zip
*.webm

# --- OS / IDE local files --------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.code-workspace
.claude/
