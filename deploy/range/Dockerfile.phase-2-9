# Phase 2.9 synthetic-range target image (egress-free build).
#
# Provenance:
#   * base image  : python:3.12-slim pinned by immutable RepoDigest (same as the Phase 2.8 image).
#   * runtime deps: fastapi/uvicorn/pydantic + transitive wheels vendored in the build context and
#                   installed with `--no-index` so the BUILD performs zero egress. httpx is NOT
#                   shipped: aegis_range.ops imports it lazily inside its diagnostics/preview worker
#                   path, which the detection-control-bypass surface never exercises.
#   * application : the first-party aegis_range source, on PYTHONPATH.
#
# This image serves ONLY the synthetic operations detection-control surface (aegis_range.ops) used
# by the Phase 2.9 consolidated acceptance: a baseline-vs-alternate request-signature detection
# control guarding one inert internal operation, plus the controller-only management plane that
# flips the scenario mode and rotates the sentinel. It never reaches a public network at runtime;
# the harness attaches it to an `--internal` docker network with no gateway.
FROM python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src

RUN groupadd --gid 65532 range && useradd --uid 65532 --gid 65532 --no-create-home range

COPY deploy/range/wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels \
        fastapi==0.116.1 uvicorn==0.35.0 pydantic==2.13.5 \
    && rm -rf /wheels

COPY src /app/src
WORKDIR /app

USER 65532:65532
CMD ["uvicorn", "aegis_range.ops:app", "--host", "0.0.0.0", "--port", "8600"]
