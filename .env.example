# Control-plane configuration. The demo works with no configuration at all (AI_PROVIDER=demo uses
# the transparent offline heuristic planner). The control plane is provider-agnostic and NEVER
# receives a provider credential: it refuses to start if AI_AUTH_TOKEN is present. Any credential
# lives only in .env.gateway, mounted only into the llm-gateway service.

# --- Provider selection -----------------------------------------------------------------------
# demo                       -> offline DemoHeuristic planner (no gateway, no egress).  [default]
# ollama                     -> local/private Ollama runtime           -> mode LOCAL_LLM
# internal_openai_compatible -> company private AI endpoint (disabled) -> mode INTERNAL_LLM
# openai_responses           -> DEPRECATED public OpenAI profile (disabled, off by default)
# deepseek                   -> DeepSeek hosted API (public egress)   -> mode PUBLIC_LLM_DEEPSEEK
# openrouter                 -> OpenRouter Qwen3.8 27B (public egress)-> mode PUBLIC_LLM_OPENROUTER
AI_PROVIDER=demo

# Local/private Ollama development defaults. Switching qwen3:4b -> qwen3:8b is configuration only.
AI_BASE_URL=http://host.docker.internal:11434
AI_MODEL=qwen3:4b
# Exact model allowlist enforced by the provider and the gateway planner. No silent substitution.
AI_ALLOWED_MODELS=qwen3:4b,qwen3:8b,foundation-sec:8b-q4
AI_CONTEXT_LENGTH=8192
AI_TEMPERATURE=0
AI_SEED=42
# Local Ollama requires no auth. Set to bearer only for an internal endpoint that needs it.
AI_AUTH_MODE=none

# Control plane -> llm-gateway RPC (internal planner-rpc network).
LLM_GATEWAY_URL=http://llm-gateway:8080

# Exact target allowlist; the executor rejects every other host.
ALLOWED_TARGET_HOSTS=lab-api
LAB_BASE_URL=http://lab-api:8001
LAB_OPENAPI_URL=http://lab-api:8001/openapi.json
DATABASE_PATH=/data/aegis.db

# Hard scan admission limits. The request budget includes the OpenAPI import. Local model
# inference is slower than a hosted API, so timeouts are generous but every scan is still bounded.
MAX_REQUESTS_PER_SCAN=8
MAX_ITERATIONS=6
MAX_MODEL_CALLS=6
MAX_CANDIDATES_PER_GENERATION=3
SCAN_TIMEOUT_SECONDS=300
# Bounded process drain before remaining controller-owned jobs are cancelled and persisted as
# non-success. Base Compose sets 10s; Uvicorn allows 12s and Docker stop allows 15s.
SHUTDOWN_GRACE_SECONDS=10
REQUEST_TIMEOUT_SECONDS=5
MODEL_TIMEOUT_SECONDS=90
MAX_TOKENS_PER_SCAN=80000
MAX_COMPLETION_TOKENS=2048
MAX_RESPONSE_BYTES=131072
# Hard per-campaign (multi-agent run) ceilings, enforced at the single AtomicBudget chokepoint:
# a run whose configured global budget exceeds either value fails closed at construction. These
# bound cumulative model spend across every agent in one run — the real backstop against a runaway
# or mis-set budget on the paid public providers (DeepSeek/OpenRouter). Defaults leave the
# calibrated per-phase budgets untouched.
MAX_TOKENS_PER_CAMPAIGN=200000
MAX_MODEL_CALLS_PER_CAMPAIGN=40

# Evidence-backed dashboard label. Do not set VALIDATED before every Phase 0.7 gate passes.
LOCAL_LLM_VALIDATION_STATUS=LOCAL_LLM_CONTRACT_V3_TESTING

# ---------------------------------------------------------------------------------------------
# Provider credential (internal or deprecated-public profiles) lives in a SEPARATE untracked file
# .env.gateway, mounted ONLY into the llm-gateway service. Local Ollama needs no credential.
# Example .env.gateway for an internal bearer endpoint:
#
#   AI_AUTH_TOKEN=<company-issued token; never paste into chat or commit>
#
# Production (company private AI endpoint) example .env:
#   AI_PROVIDER=internal_openai_compatible
#   AI_BASE_URL=https://internal-ai.example        # replace with the real company endpoint
#   AI_MODEL=<company-approved-model>
#   AI_ALLOWED_MODELS=<company-approved-model>
#   AI_AUTH_MODE=none|bearer                        # bearer requires AI_AUTH_TOKEN in .env.gateway
#
# Preferred immutable production deployment inputs are shell variables consumed by
# docker-compose.private-provider.prod.yml and its fail-closed preflight. The token VALUE is never
# an environment variable; AEGIS_PROVIDER_TOKEN_SOURCE is only an absolute host file path:
#   AEGIS_IMAGE=registry.example.com/security/aegis@sha256:<64-lowercase-hex>
#   AEGIS_DASHBOARD_IMAGE=registry.example.com/security/nginx@sha256:<64-lowercase-hex>
#   AEGIS_PROVIDER_BASE_URL=https://models.internal.company
#   AEGIS_PROVIDER_MODEL=<company-approved-model>
#   AEGIS_PROVIDER_TOKEN_SOURCE=/opt/aegis/secrets/provider-token
#   AEGIS_EXTENSION_MANIFEST_SOURCE=/opt/aegis/config/extensions.json
#   AEGIS_NGINX_CONFIG_SOURCE=/opt/aegis/config/dashboard-nginx.conf
# Application-side path after the read-only mount (standalone production file sets this itself):
#   EXTENSION_MANIFEST_PATH=/etc/aegis/extensions/manifest.json
#
# DeepSeek hosted-API example .env (public egress; no reproducible seed, no content digest):
#   AI_PROVIDER=deepseek
#   AI_BASE_URL=https://api.deepseek.com
#   AI_MODEL=deepseek-chat                          # or deepseek-reasoner
#   AI_ALLOWED_MODELS=deepseek-chat,deepseek-reasoner
# and in .env.gateway (untracked, mounted only into llm-gateway):
#   DEEPSEEK_API_KEY=<DeepSeek API key; never paste into chat or commit>
#
# OpenRouter/Qwen3.8 27B uses docker-compose.openrouter.yml. Do not place the key in this file.
# Supply only the absolute source path in the operator shell; Compose mounts the key read-only into
# llm-gateway as OPENROUTER_API_KEY_FILE. The provider rejects aliases and other model identifiers:
#   OPENROUTER_API_KEY_SOURCE=/absolute/path/openrouter-api-key
#   AI_PROVIDER=openrouter
#   AI_BASE_URL=https://openrouter.ai
#   AI_MODEL=qwen/qwen3.8-27b
#   AI_ALLOWED_MODELS=qwen/qwen3.8-27b
# Phase 1.4 only. Generate independent random values for Compose; never expose them to the shell.
# BEAST_SUPERVISOR_TOKEN=
# BEAST_BOUNDARY_TOKEN=
